{
  "expo": {
    "scheme": "notes-app-x",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./src/assets/images/favicon.png"
    },
    "icon": "./src/assets/images/icon.png",
    "splash": {
      "image": "./src/assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFCDD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.favourwright.notesappx"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/adaptive-icon.png",
        "backgroundColor": "#FDFCDD"
      },
      "package": "com.favourwright.notesappx"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://n"
        }
      ]
    ],
    "name": "notes-app-x",
    "slug": "notes-app-x",
    "extra": {
      "router": {
        "origin": "https://n"
      },
      "eas": {
        "projectId": "8e5e8abd-01d5-48e0-89ec-6f9ef0db5713"
      }
    }
  }
}
